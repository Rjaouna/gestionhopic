{% import 'workspace/_components.html.twig' as ui %}
<div class="page-heading employee-heading">
    <div><p class="employee-date"><i class="bi bi-calendar3" aria-hidden="true"></i> {{ tempo_date(today, 'EEEE d MMMM yyyy')|capitalize }}</p><h1>Bonjour, {{ user.firstName }}.</h1><p>Vos congés et absences en un coup d’œil.</p></div>
    <div class="heading-actions">{{ ui.action('Nouvelle demande', 'nouvelle') }}</div>
</div>
<section class="employee-balance-section" aria-labelledby="employee-balances" {% if inventorySummary.reopen_seconds %}data-controller="inventory-deadline"{% endif %}>
    <div class="section-heading"><h2 id="employee-balances">{{ inventorySummary.assignments ? 'Mes soldes et inventaires' : 'Mes soldes' }}</h2><a class="text-link" data-nav href="{{ path('employee_section', {section:'soldes'}) }}">Historique <i class="bi bi-chevron-right" aria-hidden="true"></i></a></div>
    {% include 'workspace/_balance_cards.html.twig' %}
</section>
{% if upcoming %}
    <section class="card employee-upcoming">
        <span class="metric-icon tone-{{ upcoming.tone }}"><i class="bi bi-{{ upcoming.icon }}" aria-hidden="true"></i></span>
        <div><h2>{{ upcoming.start_on <= today|date('Y-m-d') ? 'Congé en cours' : 'Prochain congé' }}</h2><p>{{ ui.recordLink(upcoming.type, 'demande', upcoming.id, 'Voir la demande') }} · {{ ui.range(upcoming) }}</p></div>
        <button type="button" class="btn btn-outline-tempo ms-auto" data-modal-url="{{ path('workspace_action', {action:'demande', id:upcoming.id}) }}">Détails</button>
    </section>
{% endif %}
<section class="card requests-card employee-requests" aria-labelledby="my-recent">
    <header class="card-heading"><div><h2 id="my-recent">Mes demandes récentes</h2></div><a class="btn btn-outline-tempo" data-nav href="{{ path('employee_section', {section:'demandes'}) }}">Voir tout</a></header>
    {% include 'workspace/_requests.html.twig' with {rows: recent} %}
</section>
